# /etc/systemd/system/beauty-case.service
[Unit]
Description=Beauty Case API (virtual client)
After=network-online.target
Wants=network-online.target

[Service]
User=bot
WorkingDirectory=/opt/beauty-case
ExecStart=/usr/bin/node src/index.js
Restart=always
RestartSec=3
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
