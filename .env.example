TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=
# Недорогая модель с поддержкой structured outputs (json_schema) и temperature
# Диалог с клиенткой
OPENAI_DIALOG_MODEL=gpt-5.6-luna
# Итоговая оценка работы
OPENAI_EVALUATION_MODEL=gpt-5.6-terra
# Визуализация решения команды
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
OPENAI_IMAGE_SIZE=1024x1536
OPENAI_IMAGE_QUALITY=medium
# Адрес сайта (нужен серверу, чтобы взять исходное фото клиентки)
SITE_URL=https://studstil.ru
OPENAI_MODEL=gpt-5.6-luna
# Опционально: прокси/шлюз, совместимый с OpenAI API (нужен при запуске с российских IP)
OPENAI_BASE_URL=
# Telegram user id преподавателя(ей) через запятую
ADMIN_IDS=
# Необязательные настройки
OPENAI_TEMPERATURE=0.7
HISTORY_LIMIT=16
MAX_INPUT_CHARS=500
RATE_LIMIT_MS=400
DB_PATH=data/bot.db
# --- Веб (этап 2) ---
PORT=8080
# Ключ для табло преподавателя: board.html?key=...
ADMIN_KEY=
# Откуда разрешены запросы к API (адрес сайта на GitHub Pages), через запятую
WEB_ORIGIN=https://studstil.ru,https://www.studstil.ru
# 0 = не раздавать docs/ с сервера (на VPS сайт раздаёт GitHub Pages)
SERVE_STATIC=1

GAME_MINUTES=7
ANSWER_SECONDS=60
